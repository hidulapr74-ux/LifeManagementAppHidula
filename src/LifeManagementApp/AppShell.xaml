<?xml version="1.0" encoding="utf-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:views="clr-namespace:LifeManagementApp.Views"
       x:Class="LifeManagementApp.AppShell"
       FlyoutBehavior="Disabled"
       Shell.BackgroundColor="{StaticResource DeepTeal}"
       Shell.ForegroundColor="White"
       Shell.TitleColor="White"
       Shell.TabBarBackgroundColor="White"
       Shell.TabBarTitleColor="{StaticResource Primary}"
       Shell.TabBarUnselectedColor="{StaticResource Muted}">
    <TabBar Route="main">
        <ShellContent Title="Today" Icon="home.png" Route="home" ContentTemplate="{DataTemplate views:HomePage}" />
        <ShellContent Title="My tasks" Icon="tasks.png" Route="tasks" ContentTemplate="{DataTemplate views:TodoListPage}" />
    </TabBar>
</Shell>
